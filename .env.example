# Copy this file to .env and fill in your keys. Never commit .env.
# Variable names match the adapters in sway_eval/adapters/.

# Jev decision model (TypeSafe AI): sway_eval/adapters/typesafe.py
TYPESAFE_API_KEY=

# Microsoft-Decision-1 on Microsoft Foundry: sway_eval/adapters/microsoft.py
# Target URL: the resource endpoint (https://<resource>.services.ai.azure.com) or the
# full System One URL ending in /providers/microsoft/v1/systemone; either works.
MICROSOFT_DECISION_1_TARGET_URL=
# Key auth (sent as the api-key header).
MICROSOFT_DECISION_1_KEY=
# Deployment name: the request's "model" field (pin the deployment to model version 1).
MICROSOFT_DECISION_1_DEPLOYMENT=

# OpenAI Decisions API (adapter not built yet)
OPENAI_API_KEY=

# Cloudflare Workers AI, hosted Clef and Clef-flash (adapter not built yet)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face: open-weight models and dataset uploads
HF_TOKEN=
